{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests/unidade"],

  // Pastas geradas por ferramentas: somem do explorador e da busca.
  // Continuam no disco; para ver, apague a linha correspondente.
  "files.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
