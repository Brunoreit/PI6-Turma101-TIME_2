# Copie para .env e ajuste. O docker compose lê este arquivo sozinho.

POSTGRES_PASSWORD=evolver

# Portas expostas na sua máquina
PORTA_BANCO=5432
PORTA_API=8000
PORTA_MQTT=1883
PORTA_INTERFACE=8080

# Dados da interface: exemplo (iguais ao Figma) ou api (dados reais).
# Lida no build do serviço interface: depois de mudar, rode com --build.
VITE_FONTE_DADOS=exemplo

# Faixa aceita para o setpoint de temperatura (°C)
TEMPERATURA_MIN_C=20
TEMPERATURA_MAX_C=45

# Login na API. SEGREDO_SESSAO assina os tokens: fora do desenvolvimento, use
# um valor aleatório (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Trocar o segredo invalida todos os tokens emitidos.
SEGREDO_SESSAO=desenvolvimento-troque-em-producao
SESSAO_HORAS=12   # validade do token

# Nova calibração de OD pela leitura ao vivo. O bruto de um padrão é a média
# das últimas N leituras, e só pode ser gravado com a leitura estável:
# (máximo - mínimo) / média menor que CALIBRACAO_VARIACAO_MAX (0.01 = 1%).
CALIBRACAO_N_LEITURAS=6
CALIBRACAO_VARIACAO_MAX=0.01

# Regras de alerta (segundos)
REGRAS_INTERVALO_S=10
SEM_COMUNICACAO_S=90
SETPOINT_TIMEOUT_S=120

# Células simuladas
INTERVALO_S=20        # segundos entre leituras
KEEPALIVE_S=30        # o broker declara a célula offline após 1,5 x este valor sem sinal
TAU_S=120             # rapidez com que a temperatura chega ao setpoint
ESCALA_TEMPO=1        # acelera o crescimento da cultura (60 = 1 hora por minuto)
CENARIO_C01=normal    # normal | ignorar_setpoint | falha_aquecimento
CENARIO_C02=normal
CENARIO_C03=normal
