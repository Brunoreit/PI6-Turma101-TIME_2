# Copie para .env e ajuste. O docker compose lê este arquivo sozinho.

POSTGRES_PASSWORD=evolver

# Portas expostas na sua máquina
PORTA_BANCO=5432
PORTA_API=8000
PORTA_MQTT=1883
PORTA_INTERFACE=8080

# Dados da interface: exemplo (iguais ao Figma) ou api (dados reais).
# Lida no build do serviço interface: depois de mudar, rode com --build.
VITE_FONTE_DADOS=exemplo

# Faixa aceita para o setpoint de temperatura (°C)
TEMPERATURA_MIN_C=20
TEMPERATURA_MAX_C=45

# Login na API. SEGREDO_SESSAO assina os tokens: fora do desenvolvimento, use
# um valor aleatório (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Trocar o segredo invalida todos os tokens emitidos.
SEGREDO_SESSAO=desenvolvimento-troque-em-producao
SESSAO_HORAS=12   # validade do token

# E-mail dos alertas (só o processo de regras envia). No Compose o padrão é o
# Mailpit, que mostra os e-mails em http://localhost:PORTA_MAILPIT e não
# entrega a ninguém. Para um servidor de verdade, preencha estas variáveis.
# Sem SMTP_HOST (fora do Compose), os alertas só aparecem na tela.
PORTA_MAILPIT=8025
SMTP_HOST=mailpit
SMTP_PORTA=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_SEGURANCA=nenhuma   # nenhuma | starttls | ssl
EMAIL_REMETENTE=T.U.P.A <alertas@tupa.local>
INTERFACE_URL=http://localhost:8080   # link do e-mail para a célula
EMAIL_REPETIR_S=300      # com o servidor de e-mail fora, tenta de novo depois disso
EMAIL_FUSO=America/Sao_Paulo   # fuso dos horários escritos no e-mail

# Nova calibração de OD pela leitura ao vivo. O bruto de um padrão é a média
# das últimas N leituras, e só pode ser gravado com a leitura estável:
# (máximo - mínimo) / média menor que CALIBRACAO_VARIACAO_MAX (0.01 = 1%).
CALIBRACAO_N_LEITURAS=6
CALIBRACAO_VARIACAO_MAX=0.01

# Regras de alerta (segundos)
REGRAS_INTERVALO_S=10
SEM_COMUNICACAO_S=90
SETPOINT_TIMEOUT_S=120
# Depois de aplicado, o setpoint tem SETPOINT_ATINGIR_S para a temperatura
# chegar perto do alvo; passado esse tempo, abre desvio_temperatura.
SETPOINT_ATINGIR_S=900
# Temperatura e pH só abrem alerta se nenhuma leitura dos últimos
# ALERTA_PERSISTENCIA_S esteve dentro da faixa (0 = basta uma leitura).
ALERTA_PERSISTENCIA_S=60

# Sinal de vida do consumidor e das regras (segundos). O consumidor grava a
# cada SINAL_VIDA_S; sem sinal há mais de SINAL_VIDA_LIMITE_S abre o alerta
# consumidor_parado. Sem broker há mais de BROKER_INACESSIVEL_S abre
# broker_inacessivel. Nos dois casos, sem_comunicacao não abre.
SINAL_VIDA_S=10
SINAL_VIDA_LIMITE_S=30
BROKER_INACESSIVEL_S=20

# Células simuladas
INTERVALO_S=20        # segundos entre leituras
KEEPALIVE_S=30        # o broker declara a célula offline após 1,5 x este valor sem sinal
TAU_S=120             # rapidez com que a temperatura chega ao setpoint
ESCALA_TEMPO=1        # acelera o crescimento da cultura (60 = 1 hora por minuto)
HISTORICO_HORAS=0     # horas de leituras passadas publicadas na primeira subida (0 desliga)
HISTORICO_PASSO_MIN=20 # minutos entre as leituras do histórico
# normal | ignorar_setpoint | falha_aquecimento | desvio_temperatura
# Vazio: usa o perfil da célula em simulador/perfis.py (c03 com desvio de temperatura)
CENARIO_C01=
CENARIO_C02=
CENARIO_C03=
# Para rodar as 16 células com perfis do Figma:
#   docker compose --profile 16-celulas up
# ou fora do Docker: python -m simulador
# Zerar tudo e começar com dados de demonstração: python -m simulador.semente --zerar
